NODE_ENV=development
PORT=5000

# Local MongoDB, Docker Compose service name, or MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/hostelcare

# Generate a random value of at least 32 characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# First administrator, created by `npm run seed`
ADMIN_NAME=Hostel Warden
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
