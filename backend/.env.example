NODE_ENV=development
PORT=5000

# Local MongoDB, Docker Compose service name, or MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/hostelcare

# Generate a long random value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# First administrator, created by `npm run seed`
ADMIN_NAME=Hostel Warden
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
